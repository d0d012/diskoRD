# ── Server ──────────────────────────────────────────
APP_ENV=development
APP_PORT=8080

# ── PostgreSQL ──────────────────────────────────────
DB_HOST=localhost
DB_PORT=5433
DB_USER=diskord
DB_PASSWORD=diskord
DB_NAME=diskord
DB_SSLMODE=disable
DATABASE_URL=postgres://diskord:diskord@localhost:5433/diskord?sslmode=disable

# ── Redis ───────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

# ── JWT ─────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=8760h

# ── LiveKit ─────────────────────────────────────────
LIVEKIT_HOST=localhost
LIVEKIT_PORT=7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=change-me-livekit-secret

# ── Coturn (TURN/STUN) ─────────────────────────────
TURN_HOST=localhost
TURN_PORT=3478
TURN_USERNAME=diskord
TURN_PASSWORD=change-me-turn-password

# ── Storage ─────────────────────────────────────────
STORAGE_DRIVER=local
STORAGE_PATH=./uploads
# STORAGE_DRIVER=minio
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=diskord

# ── Frontend (Vite) ────────────────────────────────
VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080/gateway
