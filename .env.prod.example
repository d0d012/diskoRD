# ── Copy this to .env.prod and fill in the values ──────────────────────────
# NEVER commit .env.prod to git

# ── Server ──────────────────────────────────────────
APP_ENV=production
APP_PORT=8080

# ── Domain & VPS ────────────────────────────────────
DOMAIN=diskord.ahmertezcan.com
VPS_IP=YOUR_HETZNER_IP_HERE

# ── PostgreSQL ──────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_USER=diskord
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=diskord
DB_SSLMODE=disable

# ── Redis ───────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ── JWT ─────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=CHANGE_ME_AT_LEAST_32_CHARS_RANDOM
JWT_REFRESH_SECRET=CHANGE_ME_AT_LEAST_32_CHARS_RANDOM_2
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# ── LiveKit ─────────────────────────────────────────
LIVEKIT_HOST=livekit
LIVEKIT_PORT=7880
# Generate with: openssl rand -hex 16
LIVEKIT_API_KEY=CHANGE_ME_LIVEKIT_KEY
LIVEKIT_API_SECRET=CHANGE_ME_LIVEKIT_SECRET

# ── Coturn (TURN/STUN) ─────────────────────────────
TURN_HOST=YOUR_HETZNER_IP_HERE
TURN_PORT=3478
TURN_USERNAME=diskord
TURN_PASSWORD=CHANGE_ME_TURN_PASSWORD

# ── Storage ─────────────────────────────────────────
STORAGE_DRIVER=local
STORAGE_PATH=./uploads
